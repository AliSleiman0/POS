<Project>

  <!--
    Central package version management: one place to bump a version, and no
    chance of two projects resolving different EF Core versions.
    Add a PackageReference in the csproj WITHOUT a Version attribute; the
    version comes from here.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!--
      Transitive pin. Microsoft.AspNetCore.OpenApi 10.0.10 resolves
      Microsoft.OpenApi 2.0.0, which has a known high-severity advisory
      (GHSA-v5pm-xwqc-g5wc). NuGetAudit correctly failed the build on it.
      Remove this pin once the ASP.NET Core package ships a patched dependency.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <!--
      Renders the OpenAPI document MapOpenApi() serves. Development-only: it is
      mapped inside the IsDevelopment() block, so nothing ships it. Needed
      because Phase 2.5's verification is a click-through of the catalog, and
      because Phase 4.1 generates the web client from the same document.
    -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.17" />
  </ItemGroup>

  <ItemGroup Label="EF Core / Postgres">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!--
      Real Postgres in the test suite, not an in-memory provider. Row-level
      security, snake_case mapping and numeric(19,4) precision are all things an
      in-memory provider silently ignores — so a suite built on one would pass
      while proving nothing about the isolation this phase exists to guarantee.
    -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
  </ItemGroup>

</Project>
