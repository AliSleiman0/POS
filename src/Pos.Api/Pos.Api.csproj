<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Points at %APPDATA%\Microsoft\UserSecrets\<id>\secrets.json, which is
         outside the repo. The id itself is not a secret. -->
    <UserSecretsId>6f75612b-7f16-4789-be4d-57ed978bc2c1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- Design-time only: enables `dotnet ef` against this startup project.
         PrivateAssets="all" keeps it out of the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pos.Core\Pos.Core.csproj" />
    <ProjectReference Include="..\Pos.Data\Pos.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pos.Api.Tests" />
  </ItemGroup>

</Project>
