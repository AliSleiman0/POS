<Project>

  <!--
    Central package version management: one place to bump a version, and no
    chance of two projects resolving different EF Core versions.
    Add a PackageReference in the csproj WITHOUT a Version attribute; the
    version comes from here.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!--
      Transitive pin. Microsoft.AspNetCore.OpenApi 10.0.10 resolves
      Microsoft.OpenApi 2.0.0, which has a known high-severity advisory
      (GHSA-v5pm-xwqc-g5wc). NuGetAudit correctly failed the build on it.
      Remove this pin once the ASP.NET Core package ships a patched dependency.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <!--
      Renders the OpenAPI document MapOpenApi() serves. Development-only: it is
      mapped inside the IsDevelopment() block, so nothing ships it. Needed
      because Phase 2.5's verification is a click-through of the catalog, and
      because Phase 4.1 generates the web client from the same document.
    -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.17" />
    <!--
      Error tracking (Phase 8.4). The only new dependency the observability work took:
      structured logging is the built-in JSON console formatter, because
      Microsoft.Extensions.Logging already does structured logging and NuGetAudit runs at
      level `low`, which makes every package a standing liability.

      What this buys that logs do not: aggregation, so a defect is one issue with a count
      rather than four hundred lines nobody reads, and a "this error is new" signal. It is
      inert without Sentry:Dsn — see SentryScrubber for what never leaves the process.
    -->
    <PackageVersion Include="Sentry.AspNetCore" Version="6.8.0" />
  </ItemGroup>

  <ItemGroup Label="EF Core / Postgres">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!--
      IL inspection, for ArchitectureTests.Core_does_not_read_the_ambient_clock. Referenced
      by tests/Pos.Core.Tests ONLY: it never reaches src/, so the two checks that Pos.Core
      declares and compiles against nothing outside the BCL are unaffected by it.

      The zero-dependency alternative is System.Reflection.Metadata, which can read the IL
      and the MemberRef table from the BCL — about sixty lines of handle-resolution
      plumbing to avoid one test-only package, on a suite that already carries
      Testcontainers. Not worth the maintenance surface for a guardrail.
    -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <!--
      Real Postgres in the test suite, not an in-memory provider. Row-level
      security, snake_case mapping and numeric(19,4) precision are all things an
      in-memory provider silently ignores — so a suite built on one would pass
      while proving nothing about the isolation this phase exists to guarantee.
    -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!--
      MetricCollector, for MetricsTests. Test-only, and it subscribes to the real meter in
      the running host rather than replacing it — so the assertion is about the same path a
      scraper reads. Needed because an instrument nobody records to and a system with
      nothing wrong produce the identical flat line on a dashboard.
    -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.8.0" />
  </ItemGroup>

</Project>
