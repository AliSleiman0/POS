<Project>

  <!--
    Applies to every project in the repo, so a newly added project cannot
    silently opt out of these. See CLAUDE.md and docs/phases/PHASE-0-foundation.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Warnings are errors from the first commit. A nullable-reference warning in
      money-handling code is a null total waiting for a customer, and turning
      this on later means clearing hundreds of warnings, which nobody does.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Deterministic, reproducible builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Fail the build if a transitive package has a known vulnerability -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      ICU on, deliberately. This was the ASP.NET template's default (true) until Phase 6.1,
      and it is incompatible with what this product is: every tenant carries an IANA
      TimeZoneId, and under invariant globalization Windows cannot resolve one at all
      (TimeZoneNotFoundException on "Europe/Dublin") while Linux still can from its own tz
      files. That is worse than either answer on its own — receipts and trading-day reports
      would work on the runner and fail on a developer's machine.

      CLAUDE.md invariant 8 depends on this: UTC in storage, the tenant's zone at the edge.
      Culture-sensitive comparisons are not a new risk, because the analyzers already require
      an explicit StringComparison or CultureInfo everywhere and warnings are errors.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Test projects are never packed and never shipped -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
