# Serves the built SPA. TLS, HTTP/2 and the public certificate are Fly's job at the
# edge, so this listens on plain HTTP inside the machine and does no ACME of its own —
# `auto_https off`, or Caddy tries to provision a certificate it cannot validate and
# fails to start.

{
	auto_https off
	admin off
	# Fly's proxy is the only thing that reaches this, and it is what knows the real
	# client address. Without this every log line reads as the proxy's own IP.
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode gzip zstd

	# Hashed filenames — index-LohDCTZi.js — are immutable by construction: a change
	# produces a different name. Cache them hard; this is most of what makes a reload
	# on a shop's connection fast.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# index.html is the opposite. It names the hashed bundles, so a cached copy pins
	# the whole app to an old version and a deploy reaches nobody.
	@html path /index.html /
	header @html Cache-Control "no-cache"

	header {
		# Removes the "Server: Caddy" advertisement. Not a defence, just no free
		# reconnaissance.
		-Server

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"

		# The register runs on a shared counter tablet. Nothing here needs a camera,
		# a microphone or a location, and a POS is a plausible target for a page that
		# would like one.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# The content security policy belongs HERE and not on the API: this is where
		# the HTML is served, and a CSP is only enforced on a browsing context.
		#
		# The refresh token lives in sessionStorage (DECISIONS.md, Phase 4.2), which
		# is readable by any injected script — so this is the control that limits what
		# an injected script could do with it. `connect-src` naming the API and
		# nothing else is the load-bearing line: a token that cannot be sent anywhere
		# is much less useful than one that can.
		#
		# `style-src` allows 'unsafe-inline' and that is a real, deliberate weakening.
		# Tailwind v4 emits its layer definitions as a stylesheet, but React sets
		# inline styles for positioning on the base-ui primitives (dialogs, popovers),
		# and those are attribute styles that no hash or nonce can cover without a
		# build-time transform this project does not have. Recorded rather than
		# quietly widened: the mitigation is that script-src stays strict, and an
		# injected *style* cannot read sessionStorage.
		#
		# CHANGE connect-src WITH THE API ORIGIN. It must match VITE_API_BASE_URL, or
		# every request is blocked by the browser with the API perfectly healthy.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://pos-api.fly.dev; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
	}

	# SPA fallback. React Router owns /register, /admin/settings and the rest, so a
	# reload on any of them must serve index.html rather than 404 — CLAUDE.md
	# invariant 11: a tablet on a counter gets reloaded, and the only remedy a shop
	# floor has is reloading.
	try_files {path} /index.html
	file_server
}
